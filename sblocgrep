#!/usr/bin/env ruby
#
# 指定された緯度経度に近い位置情報を含むページを抽出して、インポート可能なJSONファイルを作成する
# % sblocgrep N35E135 L jsonfile  (Lはkm単位の距離)
# % sblocgrep N35.6E135.5 10 project.json
#
require 'json'

def distance_km(lat1, lon1, lat2, lon2)
  rad = Math::PI / 180
  dlat = (lat2 - lat1) * rad
  dlon = (lon2 - lon1) * rad
  a = Math.sin(dlat / 2)**2 + Math.cos(lat1 * rad) * Math.cos(lat2 * rad) * Math.sin(dlon / 2)**2
  6371 * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a))
end

loc = ARGV[0]
threshold = ARGV[1]
jsonfile = ARGV[2]
unless loc && threshold && jsonfile
  STDERR.puts "% sbloc 緯度経度 距離 jsonfile"
  STDERR.puts "e.g. sbloc N35E135 1 jsonfile"
  exit
end
unless File.exist?(jsonfile)
  STDERR.puts "#{jsonfile} not found"
  exit
end

unless loc =~ /^N([\d.]+),?E([\d.]+)$/
  STDERR.puts "位置情報はN35E135のような形式で指定してください"
  exit
end
target_lat = $1.to_f
target_lon = $2.to_f

max_distance = threshold.to_f

outdata = {}
pages = []
outdata['pages'] = pages

data = JSON.parse(File.read(jsonfile))

data['pages'].each { |page|
  lines = page['lines'] || []
  # puts page['title']
  text = lines.is_a?(Array) ? lines.join("\n") : lines.to_s
  text.scan(/\[N([\d.]+),\s*E([\d.]+)(,Z[\d.]+)?\]/).each { |lat_s, lon_s|
    lat = lat_s.to_f
    lon = lon_s.to_f
    if distance_km(target_lat, target_lon, lat, lon) < max_distance
      pages.push(page)
      break
    end
  }
}

puts outdata.to_json
